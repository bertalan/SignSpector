#!/bin/sh
# Enabled with: git config core.hooksPath .githooks
# Second barrier before anything reaches the PUBLIC repository: every pushed commit (files it
# adds or changes, message, author, committer) and the pushed tree, so a commit made with
# --no-verify cannot slip through. Range logic lives in scripts/check-public.sh (tested).
set -e
zero=0000000000000000000000000000000000000000
top=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # branch deletion
    sh "$top/scripts/audit-status.sh" --gate-push "$local_sha"
    # New branch, or remote tip unknown here (force-push): commits not on any remote branch.
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base=remotes
    else
        base=$remote_sha
    fi
    sh "$top/scripts/check-public.sh" --range "$base" "$local_sha" || { echo "Push blocked: $local_ref" >&2; exit 1; }
done
