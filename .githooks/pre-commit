#!/bin/sh
# Enabled with: git config core.hooksPath .githooks
# Blocks the commit if anything unfit for a public repository is staged, or if formatting, lints or tests fail.
# Note: fmt/clippy/tests run on the working tree, not on the index (partial staging is not checked).
set -e

# The repository is public: no personal data, keys or unexpected files (allowlist + content scan).
sh "$(git rev-parse --show-toplevel)/scripts/check-public.sh" --staged

# Coherence audit every 3 commits (CLAUDE.md, "Coherence audits and unfinished work").
sh "$(git rev-parse --show-toplevel)/scripts/audit-status.sh" --gate-commit

# Non-interactive shells (GUI git clients, editors, agents) do not read ~/.zshrc.
{ command -v cargo && command -v cargo-nextest; } >/dev/null || PATH="/opt/homebrew/opt/rustup/bin:/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"
if ! command -v cargo >/dev/null; then
    echo "Error: cargo not found in PATH (install rustup)." >&2
    exit 1
fi

cargo fmt --all -- --check
cargo clippy --all-targets --quiet -- -D warnings
cargo nextest run --no-fail-fast --status-level fail
cargo test --doc --quiet
